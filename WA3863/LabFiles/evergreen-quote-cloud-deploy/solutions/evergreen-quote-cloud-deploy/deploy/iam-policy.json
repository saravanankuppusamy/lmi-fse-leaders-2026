{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployEvergreenSiteToS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::evergreen-quote-site",
        "arn:aws:s3:::evergreen-quote-site/*"
      ]
    }
  ]
}
